@using aznews.Models;
@model IList<Room>

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Danh sách phòng học</h2>
    </div>

    <p>
        <a type="button" class="btn btn-success" asp-area="Admin" asp-controller="Room" asp-action="Create">
            <i class="bi bi-file-earmark-text me-1"></i>Thêm phòng học
        </a>
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card recent-sales overflow-auto">
                    <div class="card-body mt-4">
                        <table class="table table-borderless datatable">
                            <thead>
                                <tr>
                                    <th class="col-1 text-center">#</th>
                                    <th class="col-2 text-center">Tên phòng</th>
                                    <th class="col-2 text-center">Vị trí</th>
                                    <th class="col-1 text-center">Sức chứa</th>
                                    <th class="col-1 text-center">Số lượng</th>
                                    <th class="col-2 text-center">Trạng thái</th>
                                    <th class="col-1 text-center">Hiển thị</th>
                                    <th class="col-2 text-center">Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center" scope="row">@(i++)</td>
                                        <td class="text-left text-primary">@item.RoomName</td>
                                        <td class="text-center">@item.Location</td>
                                        <td class="text-center">@item.Capacity</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-center">@item.Status</td>
                                        <td class="text-center">@item.IsActive</td>
                                        <td class="text-center">
                                            <a asp-area="Admin" asp-controller="Room" asp-action="Edit"
                                               asp-route-id="@item.RoomID" class="btn btn-primary btn-sm"
                                               title="Sửa thông tin phòng"><i class="bi bi-pencil"></i></a>
                                            <a asp-area="Admin" asp-controller="Room" asp-action="Delete"
                                               asp-route-id="@item.RoomID" class="btn btn-danger btn-sm"
                                               title="Xóa phòng học"><i class="bi bi-trash"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>