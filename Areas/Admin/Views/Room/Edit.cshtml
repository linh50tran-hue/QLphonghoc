@model aznews.Models.Room

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Sửa thông tin phòng học</h2>
    </div>

    <div class="container shadow p-5">
        <form method="post" asp-action="Edit">
            <input type="hidden" asp-for="RoomID" />
            <div class="row">
                <div class="form-group col-md-6 mb-3">
                    <label asp-for="RoomName">Tên phòng học</label>
                    <input type="text" class="form-control" asp-for="RoomName" required />
                    <span asp-validation-for="RoomName" class="alert-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label asp-for="Location">Vị trí (Tầng / Tòa nhà)</label>
                    <input type="text" class="form-control" asp-for="Location" required />
                    <span asp-validation-for="Location" class="alert-danger"></span>
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label asp-for="Capacity">Sức chứa</label>
                    <input type="number" class="form-control" asp-for="Capacity" required />
                    <span asp-validation-for="Capacity" class="alert-danger"></span>
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label asp-for="Quantity">Số lượng</label>
                    <input type="number" class="form-control" asp-for="Quantity" />
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label asp-for="Status">Trạng thái</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Available">Available (Sẵn sàng)</option>
                        <option value="Occupied">Occupied (Đang sử dụng)</option>
                        <option value="Maintenance">Maintenance (Bảo trì)</option>
                    </select>
                </div>

                <div class="form-group col-md-8 mb-3">
                    <label asp-for="Description">Mô tả</label>
                    <input type="text" class="form-control" asp-for="Description" />
                </div>

                <div class="form-group col-md-4 mb-3 mt-4">
                    <label class="form-check-label">
                        @Html.CheckBox("IsActive", Model.IsActive)
                        Hiển thị (IsActive)
                    </label>
                </div>
            </div>

            <a asp-controller="Room" asp-action="Index" class="btn btn-lg btn-warning p-2">
                <i class="bi bi-arrow-left-circle"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-lg btn-primary p-2">
                <i class="bi bi-file-plus-fill"></i> Lưu thông tin
            </button>
        </form>
    </div>
</main>