@model aznews.Models.Room

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Xác nhận xóa phòng học</h2>
    </div>

    <div class="container shadow p-5">
        <div class="row">
            <div class="form-group col-md-6 mb-3">
                <label asp-for="RoomID">Mã phòng</label>
                <input type="text" class="form-control" asp-for="RoomID" disabled />
            </div>
            <div class="form-group col-md-6 mb-3">
                <label asp-for="RoomName">Tên phòng học</label>
                <input type="text" class="form-control" asp-for="RoomName" disabled />
            </div>
            <div class="form-group col-md-6 mb-3">
                <label asp-for="Location">Vị trí</label>
                <input type="text" class="form-control" asp-for="Location" disabled />
            </div>
            <div class="form-group col-md-6 mb-3">
                <label asp-for="Capacity">Sức chứa</label>
                <input type="text" class="form-control" asp-for="Capacity" disabled />
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="RoomID" />
            <a class="btn btn-lg btn-warning p-2 me-3" href="javascript:history.back()">
                <i class="bi bi-arrow-left-circle"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-lg btn-danger p-2">
                <i class="bi bi-trash"></i> Xóa
            </button>
        </form>
    </div>
</main>