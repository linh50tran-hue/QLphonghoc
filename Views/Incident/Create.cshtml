@model aznews.Models.Incident

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Gửi báo cáo sự cố phòng học</h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item">Hỗ trợ & Sự cố</li>
                <li class="breadcrumb-item active">Gửi báo cáo sự cố</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body pt-3">
                        <h5 class="card-title">Thông tin sự cố cần hỗ trợ</h5>

                        <form asp-action="Create" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label fw-bold">1. Phòng học xảy ra sự cố <span class="text-danger">*</span></label>
                                <select id="RoomSelect" asp-for="RoomID" class="form-select" asp-items="ViewBag.RoomList" required>
                                    <option value="">-- Chọn phòng học --</option>
                                </select>
                                <span asp-validation-for="RoomID" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">2. Thiết bị gặp sự cố (Không bắt buộc)</label>
                                <select id="DeviceSelect" asp-for="DeviceID" class="form-select" asp-items="ViewBag.DeviceList">
                                    <option value="">-- Sự cố chung của phòng / Không chọn thiết bị cụ thể --</option>
                                </select>
                                <div class="form-text">Nếu chọn thiết bị cụ thể, hệ thống sẽ tự động đánh dấu thiết bị đó đang bị hỏng để kỹ thuật viên kiểm tra.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">3. Mô tả chi tiết sự cố <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="4" 
                                          placeholder="Mô tả rõ hiện tượng hỏng hóc (VD: Máy chiếu mờ, mất tín hiệu HDMI, bóng đèn nhấp nháy...)" required></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">4. Hình ảnh chụp thực tế (Không bắt buộc)</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                            </div>

                            <div class="d-flex justify-content-between">
                                <a asp-controller="Room" asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Quay lại
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-send"></i> Gửi báo cáo sự cố
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        document.getElementById("RoomSelect").addEventListener("change", function () {
            var roomId = this.value;
            var deviceSelect = document.getElementById("DeviceSelect");

            deviceSelect.innerHTML = '<option value="">-- Đang tải danh sách thiết bị... --</option>';

            if (!roomId) {
                deviceSelect.innerHTML = '<option value="">-- Sự cố chung của phòng / Không chọn thiết bị cụ thể --</option>';
                return;
            }

            fetch('/Incident/GetDevicesByRoom?roomId=' + roomId)
                .then(response => response.json())
                .then(data => {
                    deviceSelect.innerHTML = '<option value="">-- Sự cố chung của phòng / Không chọn thiết bị cụ thể --</option>';
                    data.forEach(item => {
                        var option = document.createElement("option");
                        option.value = item.deviceID;
                        option.text = item.deviceName;
                        deviceSelect.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('Lỗi tải thiết bị:', error);
                    deviceSelect.innerHTML = '<option value="">-- Sự cố chung của phòng --</option>';
                });
        });
    </script>
}